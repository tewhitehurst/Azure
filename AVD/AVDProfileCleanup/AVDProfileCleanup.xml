<?xml version="1.0" encoding="UTF-8"?>
<AVDProfileCleanup>
  <Common>
    <InstallFolder>C:\ProgramData\AVDProfileCleanup</InstallFolder>
    <ConfigUrl>https://raw.githubusercontent.com/tewhitehurst/Azure/main/AVD/AVDProfileCleanup/AVDProfileCleanup.xml</ConfigUrl>
    <ScriptUrl>https://raw.githubusercontent.com/tewhitehurst/Azure/main/AVD/AVDProfileCleanup/Clean-LocalProfiles.ps1</ScriptUrl>
    <LauncherUrl>https://raw.githubusercontent.com/tewhitehurst/Azure/main/AVD/AVDProfileCleanup/Launch-AVDProfileCleanup.ps1</LauncherUrl>
    <LocalScript>Cleanup-LocalProfiles.ps1</LocalScript>
    <LocalLauncher>Launch-AVDProfileCleanup.ps1</LocalLauncher>
    <LocalConfig>AVDProfileCleanup.xml</LocalConfig>
  </Common>

  <Installer>
    <TaskName>AVD Profile Cleanup</TaskName>
    <TriggerType>Weekly</TriggerType>
    <DaysToRun>Sunday</DaysToRun>
    <TimeToRun>3AM</TimeToRun>
    <TaskUser>SYSTEM</TaskUser>
    <UseLauncher>true</UseLauncher>
    <LogFile>C:\Logs\AVDProfileCleanup\Install-AVDProfileCleanup.log</LogFile>
  </Installer>

  <Launcher>
    <LogFile>C:\Logs\AVDProfileCleanup\Launch-AVDProfileCleanup.log</LogFile>
  </Launcher>

  <Cleanup>
    <DaysToKeep>7</DaysToKeep>
    <DeleteProfiles>false</DeleteProfiles>
    <ExcludedUsers>azAdmin</ExcludedUsers>
    <ExcludedUsers>azUser</ExcludedUsers>
    <LogFile>C:\Logs\AVDProfileCleanup\Clean-LocalProfiles.log</LogFile>
  </Cleanup>
</AVDProfileCleanup>
